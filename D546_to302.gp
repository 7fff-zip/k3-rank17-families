h_chk(s, c) = { printf("  %-100s %s\n", s, if(c, "ok", "FAILED")); c; }
{
  my(ok = 1, M = surface(pt(2)), NF, A, S, G, H, cyc);
  print("D546_to302: ICARM #302 from surface(pt(2)) of D546_K3_family.gp");
  NF = vector(5, i, w(M[1][i], if(i < 4, 1, 2)));
  ok = h_chk("(1) the change of coordinates maps [L, p, q, D, E] of surface(pt(2)) to the published #302 model", NF == NF302_PUB) && ok;
  A = ainvs(NF302_PUB); S = [[w(P[1], 2), w(P[2], 3)] | P <- M[3]];
  G = gram(S); cyc = [z | z <- matsnf(G), z != 1];
  ok = h_chk(Str("(2) fibres of the #302 model: ", fibres(A), ";  the ", #S, " sections are integral sections"),
             fibres(A) == [["I1", 24]] && vecmin(vector(#S, i, oncurve(A, S[i]) && poldegree(S[i][1]) <= 4 && poldegree(S[i][2]) <= 6))) && ok;
  ok = h_chk(Str("    their Gram matrix: det ", matdet(G), ", group ", cyc, ", no norm-2 vectors, no even overlattice"),
             matdet(G) == DET && cyc == [DET] && qfminim(G, 2, 0, 2)[1] == 0 && even_overlattices(G) == 0) && ok;
  ok = h_chk(Str("(3) the fibre at T = ", T302, " has the minimal model of #302"),
             ellminimalmodel(ellinit(subst(A, 'T, T302)))[1..5] == ellminimalmodel(E302)[1..5]) && ok;
  H = ellheightmatrix(E302, PTS302);
  ok = h_chk(Str("(4) the ", #PTS302, " published points lie on #302; rank of their height matrix: ", matrank(H)),
             vecmin(vector(#PTS302, i, ellisoncurve(E302, PTS302[i]))) && matrank(H) == #PTS302) && ok;
  printf("D546_to302: %s\n", if(ok, "all checks passed", "SOME CHECK FAILED"));
}
