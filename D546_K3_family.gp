  [1, ((-18055*X^8 - 849036*X^7 - 7020012*X^6 + 3353208732*X^5 - 81762087690*X^4 + 793519435116*X^3 - 3283939978956*X^2 - 5088090115836*X - 4041196697655)*Y + (-1325*X^10 + 646547*X^9 - 36266918*X^8 + 878515956*X^7 - 6010812510*X^6 - 170721742446*X^5 + 4092749083584*X^4 - 29870087846220*X^3 + 38973761196435*X^2 + 90906115413555*X + 82008936611550))*T^2 + ((-2650*X^9 + 1571974*X^8 - 83025372*X^7 + 2628248196*X^6 - 55251268560*X^5 + 541635114384*X^4 - 1139827259556*X^3 - 8090746783236*X^2 - 10120986847062*X + 5743363766634)*Y + (-14910*X^10 - 8366266*X^9 + 340509224*X^8 + 859459272*X^7 - 144907437828*X^6 + 2130216702084*X^5 - 14233889155896*X^4 + 27496649215368*X^3 + 115658832602898*X^2 + 66782486431206*X - 174526063508160))*T + ((4470*X^9 - 9209917*X^8 + 456664896*X^7 - 6787818516*X^6 + 63155447820*X^5 - 510030462294*X^4 - 930556852848*X^3 + 39889399415580*X^2 - 97906986262098*X - 51882506268021)*Y + (-1325*X^11 + 822572*X^10 - 28544281*X^9 + 680704072*X^8 - 20821892286*X^7 + 281345232972*X^6 + 235077600546*X^5 - 18849767164956*X^4 - 54294735828357*X^3 + 1202827973299992*X^2 - 1963421699169177*X - 1235068467289020)), 6*X^2 - 576*X - 270],
  [1, ((4505*X^12 + 104726*X^11 + 41075164*X^10 - 109778686*X^9 - 6482046067*X^8 - 117070645956*X^7 + 4376338515360*X^6 - 42387682147740*X^5 - 333140744167101*X^4 + 11285353166573070*X^3 - 104797352908236924*X^2 + 307306981562722362*X + 587180153993153175)*Y + (-218294*X^13 + 5155382*X^12 - 91236148*X^11 + 476666052*X^10 - 59681895426*X^9 - 219045124718*X^8 + 27147586732296*X^7 - 221632654911336*X^6 + 365663293583526*X^5 + 30686650114433274*X^4 - 424630296091580436*X^3 + 2606740303666421988*X^2 - 5823606653503957422*X - 1693647617933148930))*T^2 + ((-492238*X^12 + 11804240*X^11 - 367959676*X^10 + 2413807664*X^9 - 397815170*X^8 - 1811552971872*X^7 + 35282647632888*X^6 - 216451857826080*X^5 + 1722035569874958*X^4 - 8605839719368944*X^3 + 79966911728282436*X^2 - 305470426308497424*X + 728881614998101890)*Y + (9010*X^14 + 1151514*X^13 + 24452564*X^12 + 1123441540*X^11 - 48329416850*X^10 + 237058448966*X^9 + 7783706961848*X^8 - 131223918277320*X^7 - 143033738791698*X^6 + 23664293962226694*X^5 - 246976373246915052*X^4 + 651358745083132164*X^3 + 5382987542981228466*X^2 - 39559849346894327334*X + 47120456837311921440))*T + ((4505*X^13 + 1401027*X^12 - 28640584*X^11 + 1596034140*X^10 - 34330163031*X^9 - 30477511969*X^8 + 11411714832312*X^7 - 191252903427792*X^6 + 1212153491322171*X^5 + 3744927527621553*X^4 - 128915793541467504*X^3 + 988813606604545332*X^2 - 3791120601721996413*X + 4816816483031432685)*Y + (-269439*X^14 + 5636729*X^13 - 87653250*X^12 - 3234658870*X^11 + 163172591471*X^10 - 2985177673897*X^9 + 13377462989968*X^8 + 333607827160140*X^7 - 5664329712161937*X^6 + 30300387691710231*X^5 + 144642086016485382*X^4 - 3393033768470559798*X^3 + 23737436992406041281*X^2 - 83139593889530724039*X + 95802102863603348940)), 6*X^6 + 60*X^5 + 2274*X^4 - 20376*X^3 + 591786*X^2 - 3559140*X + 26693550],
  [2, ((-1590*X^7 + 826337*X^6 - 20465266*X^5 + 162812349*X^4 - 416770794*X^3 - 1290624813*X^2 + 13024373778*X - 249015298545)*Y + (53117*X^8 - 1370072*X^7 - 10066374*X^6 + 672318580*X^5 - 8615961936*X^4 + 37085565024*X^3 + 184273313310*X^2 - 1767871940796*X + 2740357584315))*T^2 + ((125314*X^7 - 8735362*X^6 + 175625482*X^5 - 1042900938*X^4 - 2861914266*X^3 + 40101527034*X^2 + 17822528334*X - 737211540078)*Y + (-3180*X^9 + 1490384*X^8 - 34651882*X^7 + 192788258*X^6 - 168485386*X^5 + 16534331658*X^4 - 226696910526*X^3 + 267468121926*X^2 + 7514856502686*X - 21099767524290))*T + ((-1590*X^8 + 568000*X^7 - 2491026*X^6 - 315890020*X^5 + 4785433650*X^4 - 9059695488*X^3 - 240228524142*X^2 + 1693661799492*X - 3208588528860)*Y + (70607*X^9 - 6495211*X^8 + 158264713*X^7 - 800741887*X^6 - 15167115053*X^5 + 179336304999*X^4 + 1475132211*X^3 - 8547940196469*X^2 + 44223402183714*X - 66788357767560)), X - 15]
];}

\\ ============================================= functions =============================================

B_of(nf) = nf[2]*nf[3]*(nf[1] + nf[2] + nf[3]) - nf[2]*nf[5] - nf[3]*nf[4];
ainvs(nf) = { my(B = B_of(nf)); [-nf[1], nf[4] + nf[5], -B, nf[4]*nf[5], 0]; }
disc_(ai) = { my([a1, a2, a3, a4, a6] = ai, b2 = a1^2 + 4*a2, b4 = a1*a3 + 2*a4, b6 = a3^2 + 4*a6,
  b8 = a1^2*a6 + 4*a2*a6 - a1*a3*a4 + a2*a3^2 - a4^2); -b2^2*b8 - 8*b4^3 - 27*b6^2 + 9*b2*b4*b6; }
c4_(ai) = { my([a1, a2, a3, a4, a6] = ai, b2 = a1^2 + 4*a2, b4 = a1*a3 + 2*a4); b2^2 - 24*b4; }
oncurve(ai, S) = S[2]^2 + ai[1]*S[1]*S[2] + ai[3]*S[2] - (S[1]^3 + ai[2]*S[1]^2 + ai[4]*S[1] + ai[5]) == 0;

\\ ---- square roots: in Q, or in K = Q(X)[Y]/(Ceq) (via norm and trace: only square roots in Q(X) are needed) ----
h_ratsqrt(f) = { my(a, b); if(f == 0, return(0)); if(issquare(numerator(f), &a) && issquare(denominator(f), &b), a/b, []); }
h_sqrt(s) = {
  if(s == 0, return(0));
  if(type(s) != "t_POLMOD", my(r); return(if(issquare(s, &r), r, [])));
  my(n = h_ratsqrt(norm(s)), tr = trace(s));
  if(n == [], return([]));
  foreach([n, -n], nn, my(tau = h_ratsqrt(tr + 2*nn)); if(tau != [] && tau != 0, my(t = (s + nn)/tau); if(t^2 == s, return(t))));
  [];
}
\\ square root of a polynomial in T (coefficients in Q or in K), or []
h_polsqrt(f) = {
  my(n = poldegree(f, 'T), m, c, gv, g);
  if(f == 0, return(0)); if(n % 2, return([]));
  m = n/2; c = vector(n + 1, k, polcoef(f, k - 1, 'T)); gv = vector(m + 1);
  gv[m + 1] = h_sqrt(c[n + 1]); if(gv[m + 1] == [], return([]));
  for(j = 1, m, my(k = m - j, s = c[m + k + 1]);
    for(a = k + 1, m - 1, my(b = m + k - a); if(b >= k + 1 && b <= m, s -= gv[a + 1]*gv[b + 1]));
    gv[k + 1] = s/(2*gv[m + 1]));
  g = sum(k = 0, m, gv[k + 1]*'T^k);
  if(g^2 == f, g, []);
}
\\ the section on the line y - y0 = u (x - x0) through the built-in section P_k = (x0, y0), k = 1, 2, 3:
\\ x = x0 + t with t^2 - A t - (M u - K) = 0; the discriminant A^2 + 4 (M u - K) is a square in the coefficient field
line_section(nf, u, k) = {
  my([L, p, q, D, E] = nf, B = B_of(nf), x0, y0, A, M, K, g);
  [x0, y0] = [[0, 0], [-D, 0], [-p*q, q*(p*q - D)]][k];
  A = u^2 - L*u - (3*x0 + D + E); M = 2*y0 - L*x0 - B; K = L*y0 + 3*x0^2 + 2*(D + E)*x0 + D*E;
  g = h_polsqrt(A^2 + 4*(M*u - K));
  if(g == [], error("line_section: the discriminant is not a square"));
  [x0 + (A + g)/2, y0 + u*(A + g)/2];
}
builtin(nf) = { my([L, p, q, D, E] = nf); [[0*'T, 0*'T], [-D, 0*'T], [-p*q, q*(p*q - D)]]; }

\\ ---- the surface over the function field K = Q(C) = Q(X)[Y]/(Ceq) ----
h_Kpol(num, den) = { my(s = 0); for(k = 0, poldegree(num, 'T), s += Mod(polcoef(num, k, 'T)/den, Ceq)*'T^k); s; }
generic() = {
  my(nf = vector(5, i, h_Kpol(NF[i], 1)), S = builtin(nf));
  S = concat(S, vector(#SLOPES, i, line_section(nf, h_Kpol(SLOPES[i][2], SLOPES[i][3]), SLOPES[i][1])));
  [nf, ainvs(nf), S];
}

\\ ---- the member at a rational point P != O ----
\\ Generic case: substitute (X, Y) = P.  At the finitely many points where L, p, q all vanish, the model is first divided
\\ by a local parameter s at P: (L,p,q,D,E,u) -> (L,p,q,D,E,u)/s^(e,e,e,2e,2e,e) (an isomorphic model over K).
h_local(P, prec) = {                          \\ [X(s), Y(s)]: C near P, s = X - x(P) (or Y - y(P) at 2-torsion)
  my(c = CURVE, F(x, y) = y^2 + (c.a1*x + c.a3)*y - (x^3 + c.a2*x^2 + c.a4*x + c.a6), x, y, it = 3 + ceil(log(prec + 1)/log(2)));
  if(2*P[2] + c.a1*P[1] + c.a3 != 0,
    x = P[1] + 's + O('s^prec); y = P[2] + O('s^prec); for(i = 1, it, y -= F(x, y)/(2*y + c.a1*x + c.a3)),
    y = P[2] + 's + O('s^prec); x = P[1] + O('s^prec); for(i = 1, it, x -= F(x, y)/(c.a1*y - 3*x^2 - 2*c.a2*x - c.a4)));
  [x, y];
}
h_at(num, den, P, w, e, XY) = {                \\ the value at P of (num/den) / s^(w e), a polynomial in T ("pole" if none)
  my(r = 0);
  for(k = 0, poldegree(num, 'T), my(c = polcoef(num, k, 'T), v);
    if(e == 0, my(d = subst(den, 'X, P[1])); if(d == 0, return("pole")); v = subst(subst(c, 'Y, P[2]), 'X, P[1])/d,
      my(z = subst(subst(c, 'Y, XY[2]), 'X, XY[1])/subst(den, 'X, XY[1])); v = if(z == 0, 0, if(valuation(z, 's) < w*e, return("pole"), polcoef(z, w*e, 's))));
    r += v*'T^k);
  r;
}
surface(P) = {
  if(#P < 2, error("surface: P = O is the pole of the model"));
  if(!ellisoncurve(CURVE, P), error("surface: P is not on C"));
  my(e = 0, XY = 0, nf, S);
  if(vector(3, i, subst(subst(NF[i], 'Y, P[2]), 'X, P[1])) == [0, 0, 0],
    XY = h_local(P, 24); e = 99;
    for(i = 1, 5, for(k = 0, poldegree(NF[i], 'T), my(z = subst(subst(polcoef(NF[i], k, 'T), 'Y, XY[2]), 'X, XY[1]));
      if(z != 0, e = min(e, valuation(z, 's) \ if(i <= 3, 1, 2))))));
  nf = vector(5, i, h_at(NF[i], 1, P, if(i <= 3, 1, 2), e, XY));
  S = builtin(nf);
  \\ at a degenerate point a slope may have a pole: that section is then returned as "undefined"
  for(i = 1, #SLOPES, my(u = h_at(SLOPES[i][2], SLOPES[i][3], P, 1, e, XY));
    S = concat(S, [if(type(u) == "t_STR", "undefined", iferr(line_section(nf, u, SLOPES[i][1]), E, "undefined"))]));
  [concat(nf, [B_of(nf)]), ainvs(nf), S];
}

\\ ---- lattice of sections: <P,Q> = 2 + P.O + Q.O - P.Q with P.O = 0 (integral sections), no reducible fibres ----
meet(P, Q) = {                                \\ intersection number of two integral sections, T = oo included
  my(dx = P[1] - Q[1], dy = P[2] - Q[2]);
  if(dx == 0 && dy == 0, return(99));         \\ the same section (happens only at degenerate points)
  poldegree(gcd(dx, dy), 'T) + max(0, min(if(dx, valuation(subst(dx, 'T, 1/'s)*'s^4, 's), 99),
                                          if(dy, valuation(subst(dy, 'T, 1/'s)*'s^6, 's), 99)));
}
gram(S) = matrix(#S, #S, i, j, if(i == j, 4, 2 - meet(S[i], S[j])));
even_overlattices(G) = {                      \\ number of y/p (p^2 | det, G y = 0 mod p) with even norm
  my(f = factor(matdet(G)), cnt = 0);
  for(i = 1, #f~, my(p = f[i, 1]); if(f[i, 2] < 2, next);
    my(K = matker(G*Mod(1, p)), r = #K);
    forvec(c = vector(r, j, [0, p - 1]), if(c == vector(r), next);
      my(y = lift(K*c~), n = y~*G*y/p^2); if(denominator(n) == 1 && n % 2 == 0, cnt++)));
  cnt;
}
h_good(ai, Dl, p) = {
  for(i = 1, 5, foreach(if(ai[i] == 0, [0], Vec(ai[i])), c, if(denominator(c) % p == 0, return(0))));
  my(d = Dl*Mod(1, p)); poldegree(d) == 24 && poldisc(d) != 0;
}
\\ S(p) = #X(F_p) - (p+1)^2 = -sum over t in P^1(F_p) of a_t(p)
h_fibre_count(c, p) = {                       \\ -a_t(p) for the fibre y^2 = c4 x^3 + c3 x^2 + c2 x + c1 (mod p)
  my(g = c[4]*'xx^3 + c[3]*'xx^2 + c[2]*'xx + c[1]);
  if(poldisc(g) != 0, -ellap(ellinit([0, c[3]/4, 0, c[2]/4, c[1]/4])), sum(x = 0, p - 1, kronecker(lift(subst(g, 'xx, x)), p)));
}
Sp(ai, p) = {
  my(G = (ai[1]*'xx + ai[3])^2 + 4*('xx^3 + ai[2]*'xx^2 + ai[4]*'xx + ai[5]), C = vector(4, k, polcoef(G, k - 1, 'xx)*Mod(1, p)), s = 0);
  for(t = 0, p - 1, s += h_fibre_count(vector(4, k, subst(C[k], 'T, t)), p));
  s + h_fibre_count(vector(4, k, polcoef(lift(C[k]), [12, 8, 4, 0][k], 'T)*Mod(1, p)), p);    \\ + the fibre at T = oo
}
\\ singular fibres over Qbar: [type, number], type I_m or "add" (additive)
fibres(ai) = {
  my(Dl = disc_(ai), c4 = c4_(ai), f, ty = List(), nb = List(), dinf);
  if(Dl == 0, return("Delta = 0"));
  f = factor(Dl);
  for(i = 1, #f~, my(g = f[i, 1]); if(poldegree(g, 'T) == 0, next);
    listput(ty, if(polresultant(g, c4, 'T) == 0, "add", Str("I", f[i, 2]))); listput(nb, poldegree(g, 'T)));
  dinf = 24 - poldegree(Dl, 'T);
  if(dinf > 0, listput(ty, if(poldegree(c4, 'T) < 8, "add", Str("I", dinf))); listput(nb, 1));
  my(u = vecsort(Vec(ty), , 8)); vector(#u, j, [u[j], sum(i = 1, #ty, if(ty[i] == u[j], nb[i]))]);
}

\\ ---- verify(P): certificate for the member at P ----
verify(P, primes = [1009, 1013, 1019]) = {
  my(t0 = getabstime(), M = surface(P), ai = M[2], S = M[3], Dl = disc_(ai), pp = 1009, G, ok);
  if(#select(z -> type(z) == "t_STR", S), printf("verify %s: some sections are undefined at P (degenerate point): NOT certified\n", P); return(0));
  if(Dl == 0 || poldegree(Dl, 'T) != 24, printf("verify %s: Delta = 0 or of degree < 24: NOT certified\n", P); return(0));
  while(!h_good(ai, Dl, pp) && pp < 20000, pp = nextprime(pp + 1));
  G = gram(S);
  my(r = [vecmin(vector(5, i, poldegree(ai[i], 'T) <= 2*[1,2,3,4,6][i])), poldegree(Dl, 'T) == 24 && pp < 20000,
          vecmin(vector(#S, i, oncurve(ai, S[i]))), vecmin(vector(#S, i, poldegree(S[i][1], 'T) <= 4 && poldegree(S[i][2], 'T) <= 6))],
     dt = matdet(G), cyc = [z | z <- matsnf(G), z != 1], good = (dt == DET && cyc == [DET]), n2 = if(good, qfminim(G, 2, 0, 2)[1], "-"), ov = if(good, even_overlattices(G), "-"));
  printf("verify %s:\n  deg a_i <= 2i: %d;  Delta of degree 24, squarefree (mod %d): %d\n", P, r[1], pp, r[2]);
  printf("  %d sections on the curve: %d, integral (deg x <= 4, deg y <= 6): %d\n", #S, r[3], r[4]);
  printf("  Gram matrix: det %d, discriminant group %s, vectors of norm 2: %s, even overlattices: %s\n", dt, cyc, n2, ov);
  if(#primes, printf("  S(p): %s\n", vector(#primes, i, my(p = primes[i]); [p, if(h_good(ai, Dl, p), Sp(ai, p), "bad")])));
  ok = vecmin(r) && good && n2 == 0 && ov == 0;
  printf("  => %s   (%.1f s)\n", if(ok, Str("K3 surface with 24 I1 fibres; the 17 sections generate its Mordell-Weil lattice (rank 17, det ", DET, ")"), "NOT certified"), (getabstime() - t0)/1000.);
  ok;
}

h_chk(s, c) = { printf("  %-84s %s\n", s, if(c, "ok", "FAILED")); c; }
h_spT(f, P) = { my(r = 0); for(k = 0, poldegree(f, 'T), my(z = lift(polcoef(f, k, 'T))); r += subst(subst(z, 'Y, P[2]), 'X, P[1])*'T^k); r; }
h_branch(ai, p) = { my(c = c4_(ai)*Mod(1, p), dd = disc_(ai)*Mod(1, p), d = poldisc(c^3 - 'z*dd, 'T)); d/pollead(d); }
\\ ---- verify_generic(): the statements (1), (2), (4) of the header, by exact computation over K = Q(C) ----
verify_generic() = {
  my(t0 = getabstime(), ok = 1, chk = h_chk, M, ai, S, DK, P0, P1, D0, pp, G0, p, S0, ai0, ai1);
  printf("verify_generic: C = %s, det %d\n", CURVE[1..5], DET);
  ok = chk("L, p, q, D, E: coefficients in Z[X,Y] of degrees 2, 2, 2, 4, 4 in T", vecmin(vector(5, i, poldegree(NF[i], 'T) <= [2,2,2,4,4][i] && poldegree(NF[i], 'Y) <= 1 && denominator(content(NF[i])) == 1))) && ok;
  M = generic(); ai = M[2]; S = M[3];                              \\ (errors out if some discriminant is not a square in K[T])
  ok = chk(Str("the ", #SLOPES, " line discriminants are squares in K[T]; all ", #S, " sections satisfy the equation identically"), vecmin(vector(#S, i, oncurve(ai, S[i])))) && ok;
  ok = chk("the sections are integral (deg x <= 4, deg y <= 6); deg a_i <= 2i", vecmin(vector(#S, i, poldegree(S[i][1], 'T) <= 4 && poldegree(S[i][2], 'T) <= 6)) && vecmin(vector(5, i, poldegree(ai[i], 'T) <= 2*[1,2,3,4,6][i]))) && ok;
  DK = disc_(ai);
  ok = chk("Delta_K has degree 24 (leading coefficient nonzero in K)", poldegree(DK, 'T) == 24) && ok;
  \\ specialisation at P0: all coefficients are regular there, so it commutes with the ring operations
  P0 = pt(BASEPTS[1][1], BASEPTS[1][2]); P1 = pt(BASEPTS[2][1], BASEPTS[2][2]);
  S0 = vector(#S, i, [h_spT(S[i][1], P0), h_spT(S[i][2], P0)]); ai0 = vector(5, i, h_spT(ai[i], P0));
  D0 = disc_(ai0); pp = 1009; while(!h_good(ai0, D0, pp), pp = nextprime(pp + 1));
  ok = chk(Str("at P0 = ", P0, ": Delta(P0) = Delta_K(P0) is squarefree of degree 24 (mod ", pp, "), so disc_T Delta_K != 0"), D0 == h_spT(DK, P0) && poldegree(D0) == 24) && ok;
  G0 = gram(S0);
  ok = chk(Str("Gram matrix at P0: det ", matdet(G0), ", group ", [z | z <- matsnf(G0), z != 1], ", no norm-2 vectors, no even overlattice"),
           matdet(G0) == DET && [z | z <- matsnf(G0), z != 1] == [DET] && qfminim(G0, 2, 0, 2)[1] == 0 && even_overlattices(G0) == 0) && ok;
  ai1 = surface(P1)[2]; p = 10007;
  while(!(h_good(ai0, D0, p) && h_good(ai1, disc_(ai1), p) && poldegree(c4_(ai0)*Mod(1, p)) == 8 && poldegree(c4_(ai1)*Mod(1, p)) == 8), p = nextprime(p + 1));
  ok = chk(Str("branch polynomials disc_T(c4^3 - z Delta) at P0 and ", P1, " differ mod ", p, ": not isotrivial"), h_branch(ai0, p) != h_branch(ai1, p)) && ok;
  \\ (3): the finite exceptional set is O, the poles of the section coordinates below, and the zeros of disc_T Delta_K
  my(dens = []); foreach(S, s, foreach(s, c, for(k = 0, poldegree(c, 'T), my(f = lift(polcoef(c, k, 'T)));
    foreach([polcoef(f, 0, 'Y), polcoef(f, 1, 'Y)], a, my(d = denominator(a)); if(poldegree(d, 'X) > 0, dens = setunion(dens, Set(factor(d)[,1]~)))))));
  printf("  (3) follows by specialisation (see PROOF) outside O, the zeros of disc_T Delta_K (a nonzero element of K)\n");
  printf("      and the poles of the section coordinates, which lie over the roots of %s\n", dens);
  printf("verify_generic: %s   (%.1f s)\n", if(ok, "all checks passed", "SOME CHECK FAILED"), (getabstime() - t0)/1000.);
  ok;
}
